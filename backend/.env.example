PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
JWT_SECRET="your-super-secret-jwt-key"
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:4000"

# Google OAuth 2.0 (Google Cloud Console -> Credentials -> OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# LinkedIn OAuth 2.0 (LinkedIn Developer Portal -> Auth -> OAuth 2.0)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_CALLBACK_URL="http://localhost:4000/api/auth/linkedin/callback"

# Seamless mock OAuth for dev/demo testing if real credentials are not yet configured
ENABLE_MOCK_OAUTH="true"

